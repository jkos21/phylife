{
  "name": "phylife",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "pipeline:sync": "node --experimental-strip-types scripts/sync.ts",
    "pipeline:seed": "node --experimental-strip-types scripts/seed.ts",
    "pipeline:stats": "node --experimental-strip-types scripts/stats.ts",
