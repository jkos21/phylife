    "test:walkthrough": "npx tsx scripts/test-ui-walkthrough.ts",
    "test": "npx tsx scripts/test-backend-integrations.ts && npx tsx scripts/test-ui-walkthrough.ts"
  },
  "dependencies": {
    "lucide": "^0.475.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
